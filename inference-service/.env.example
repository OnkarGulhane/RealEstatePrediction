# Standalone Inference Service Configuration (Placeholder example - do not commit real secrets)
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001

# Path to the immutable model pipeline artifact and paired metadata.
# Paths may be absolute, or relative to the inference-service/ service root.
MODEL_ARTIFACT_PATH=../ml/training/experiments/phase2/model_pipeline.joblib
MODEL_METADATA_PATH=../ml/training/experiments/phase2/metadata.json

# Optional internal service token for development, mandatory in production.
# Provide a secret token and send it via the X-Service-Token HTTP header.
SERVICE_TOKEN=your-secret-internal-service-token-here
