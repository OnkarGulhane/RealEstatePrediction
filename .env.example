# Real Estate Price Prediction Platform — Root Environment Example
# Note: Real credentials and secrets must NEVER be committed to source control.
# Copy per-service examples into their respective service directories.

# Global / Environment Identifier
ENVIRONMENT=development
DEBUG=True

# Default Service Ports & URLs
FRONTEND_PORT=3000
BACKEND_PORT=8000
INFERENCE_PORT=8001

FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000/api/v1
INFERENCE_SERVICE_URL=http://localhost:8001
